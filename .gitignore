# 依赖与构建产物
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# 环境变量：绝不能提交（覆盖 .env.local / .env.local.bak / .env.production 等所有变体）
.env*
!.env.example

# npm 镜像配置：只是国内网络的加速选项，不应该强加给其他人。
# 需要的话从 .npmrc.example 复制一份。
.npmrc

# 宣传片配音：3.5MB 的 base64 音频，由 npm run video:voice 生成。
# 生成物不进版本库，否则每次重录都会在历史里留一份。
promo/bilibili/voiceover.js
promo/bilibili/.tmp-voice/

# 本地临时文件
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.scratch*

# Vercel 部署令牌（敏感）
.vercel-token.txt
.vercel

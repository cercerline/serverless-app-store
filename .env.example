# ============================================================================
#  应用分发平台 · 环境变量清单
#  复制本文件为 .env.local 可作本地开发；线上请在 Vercel 控制台逐项添加。
#  所有值都不要加引号，也不要提交到 Git。
# ============================================================================

# ---------------------------------------------------------------- 数据库（必填）
# Neon / Vercel Postgres 连接串。Vercel 集成会自动注入 POSTGRES_URL，
# 本应用两者都识别；手动填写时用 DATABASE_URL。
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------------------------------------- 对象存储（必填）
# Cloudflare R2。在 Cloudflare 控制台 → R2 → Manage API Tokens 创建，
# 权限选「Object Read & Write」，并限定到下面这个存储桶。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 可选：给存储桶绑定自定义域名后填写，图标/截图将直接由 R2 提供，减轻函数负担。
# 未填写时资源会经由站点代理转发（功能相同，但每次都会触发一次函数调用）。
R2_PUBLIC_BASE_URL=

# 可选：仅当存储桶建在 EU 或 FedRAMP 辖区时才需要，填 eur 或 fedramp。
R2_JURISDICTION=

# -------------------------------------------------------------- 管理员（必填）
# 登录用户名，默认 admin。
ADMIN_USERNAME=admin

# 方式一（最省事）：直接写明文密码。
ADMIN_PASSWORD=

# 方式二（推荐）：写 scrypt 哈希，用 `npm run admin:hash` 生成。
# 两者同时存在时，以 ADMIN_PASSWORD_HASH 为准。
ADMIN_PASSWORD_HASH=

# 可选：会话 Cookie 的签名密钥。留空则由管理员密码派生，
# 这样修改密码会自动让旧会话失效。
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------ 站点（可选）
# 浏览器标签页与页头显示的名称。
NEXT_PUBLIC_SITE_NAME=应用分发中心

# ------------------------------------------------------ 多用户上传限流（可选）
# 每个账号最多可提交多少个应用（默认 10）。达到上限后提交会被拒绝。
MAX_APPS_PER_USER=10

# 单个上传文件的大小上限，单位 MB（默认 200）。
MAX_UPLOAD_MB=200

# 同一 IP 每小时最多注册几个账号（默认 15）。
# 学校、公司共用出口 IP 时，这个值不宜太小。
MAX_SIGNUPS_PER_HOUR=15

# 服务端扫描 APK 字节码的大小上限，单位 MB（默认 25）。超过则跳过扫描。
# MAX_DEX_SCAN_MB=25

# 禁止上传的权限，逗号分隔（默认 INTERNET）。
# 留空则不做权限限制；填 INTERNET 即「不接受需要联网的应用」。
# BLOCKED_PERMISSIONS=INTERNET

# 设为 true 可关闭公开注册，回到邀请制：只有你手动开通的账号能登录上传。
# DISABLE_REGISTRATION=true
